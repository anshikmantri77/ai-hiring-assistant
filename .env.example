# Postgres connection string (Supabase / Neon / Vercel Postgres).
# Supabase: use the "Session pooler" URI, and append ?sslmode=require
DATABASE_URL=postgresql://user:pass@host:5432/postgres?sslmode=require

# Vapi voice AI — https://dashboard.vapi.ai → API Keys. Never commit real values.
# Private key: server only.
VAPI_PRIVATE_KEY=
# Public key: sent to the candidate's browser for web interviews. Restrict its
# allowed origins to your domain in the Vapi dashboard.
VAPI_PUBLIC_KEY=
# Produced by `npm run seed:agent`.
VAPI_ASSISTANT_ID=
# Optional. Enables "Phone-call selected". Free Vapi numbers dial US only;
# Indian (+91) numbers need an imported SIP/carrier number (Plivo, Exotel, Twilio).
VAPI_PHONE_NUMBER_ID=
# Shared secret Vapi sends as x-vapi-secret on webhooks. openssl rand -hex 24
VAPI_WEBHOOK_SECRET=

# Public HTTPS origin Vapi posts webhooks to. Leave as localhost locally and
# the dashboard falls back to polling.
APP_URL=http://localhost:3000

# Password for the recruiter dashboard (HTTP Basic, any username).
# Unset = open locally; deployments refuse to serve without it.
ADMIN_PASSWORD=

# Candidate sourcing provider: mock | searchapi | pdl | apollo
PEOPLE_PROVIDER=mock

# SearchAPI.io — finds real LinkedIn profiles (no phone; screen them via interview link).
SEARCHAPI_API_KEY=

# People Data Labs — free tier on signup; results carry a mobile number.
PDL_API_KEY=

# Apollo.io — phone numbers require a plan with phone reveal enabled.
APOLLO_API_KEY=

# Optional. If unset, job-description parsing falls back to keyword extraction.
ANTHROPIC_API_KEY=
