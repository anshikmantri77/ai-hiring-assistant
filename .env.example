# Postgres connection string (Supabase / Neon / Vercel Postgres).
# Supabase: use the "Session pooler" URI, and append ?sslmode=require
DATABASE_URL=postgresql://user:pass@host:5432/postgres?sslmode=require

# Hunar Voice AI. Key is sent as the X-API-Key header. Never commit the real value.
HUNAR_API_KEY=
# Produced by `npm run seed:agent`. Paste the printed UUID here.
HUNAR_AGENT_ID=

# Public HTTPS origin Hunar posts webhooks back to.
# Local dev: run `ngrok http 3000` and paste the https URL here.
APP_URL=http://localhost:3000

# Shared secret appended to every webhook URL as ?token=... so only Hunar's
# callbacks are accepted. Generate with: openssl rand -hex 24
WEBHOOK_TOKEN=

# Candidate sourcing provider: mock | pdl | apollo
PEOPLE_PROVIDER=mock

# People Data Labs — the most accessible real provider. Free tier on signup at
# dashboard.peopledatalabs.com. Search is filtered to records that carry a
# mobile number, which is what a screening call needs.
PDL_API_KEY=

# Apollo.io — phone numbers require a plan with phone reveal enabled.
APOLLO_API_KEY=

# Optional. If unset, job-description parsing falls back to keyword extraction.
ANTHROPIC_API_KEY=
